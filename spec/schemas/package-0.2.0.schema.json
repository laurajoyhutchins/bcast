{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcast:schema:package:0.2.0",
  "title": "BCAST Package 0.2.0",
  "description": "Companion JSON Schema for the normative provider-neutral BCAST Package 0.2.0 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "publication",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "bcast.package/0.2.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^bcastpkg:sha256:[0-9a-f]{64}$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "namespace",
        "family",
        "edition"
      ],
      "properties": {
        "publication_id": {
          "type": "string",
          "pattern": "^bcastpub:sha256:[0-9a-f]{64}$"
        },
        "namespace": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "issuing_body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "kind",
          "locator",
          "status"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^bcastobj:sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "document",
              "chapter",
              "appendix",
              "section",
              "subsection",
              "paragraph",
              "list_item",
              "definition_entry",
              "table",
              "figure",
              "note",
              "unsupported"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "parent_id": {
            "type": "string",
            "pattern": "^bcastobj:sha256:[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved",
              "unsupported"
            ]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_type",
              "text"
            ],
            "properties": {
              "media_type": {
                "const": "text/plain"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "citation"
            ],
            "properties": {
              "citation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "source_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
