{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcast:schema:sbvr-proposal-batch:0.1.0",
  "title": "BCAST source-pinned SBVR-inspired proposal batch",
  "description": "Proposed regulatory propositions derived from bounded source passages, not an OMG SBVR XMI interchange model or an authoritative interpretation. Exact source text must stay rights-scoped. Every batch must carry a source-package BCAST 0.2 materialization; Rust rehashes and verifies member identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "source_package",
    "source",
    "passages",
    "proposals",
    "accounting"
  ],
  "properties": {
    "schema_version": {
      "const": "bcast.sbvr_proposal_batch/0.1.0"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "editions"
      ],
      "properties": {
        "schema_version": {
          "const": "bcast.rule_ir/0.1.0"
        },
        "editions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "family",
        "edition",
        "publication_id",
        "package_id",
        "artifact_sha256",
        "media_type"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "publication_id": {
          "type": "string",
          "pattern": "^bcastpub:sha256:[0-9a-f]{64}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^bcastpkg:sha256:[0-9a-f]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "const": "application/pdf"
        }
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/passage"
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extracted_passages",
        "classified_passages",
        "proposals",
        "admitted",
        "unresolved",
        "rejected"
      ],
      "properties": {
        "extracted_passages": {
          "type": "integer",
          "minimum": 0
        },
        "classified_passages": {
          "type": "integer",
          "minimum": 0
        },
        "proposals": {
          "type": "integer",
          "minimum": 0
        },
        "admitted": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_package": {
      "type": "object",
      "required": [
        "schema_version",
        "package_version",
        "publication",
        "package_id",
        "objects"
      ],
      "properties": {
        "schema_version": {
          "const": "bcast.package/0.2.0"
        },
        "package_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publication": {
          "type": "object",
          "required": [
            "publication_id",
            "namespace",
            "family",
            "edition"
          ],
          "properties": {
            "publication_id": {
              "type": "string",
              "pattern": "^bcastpub:sha256:[0-9a-f]{64}$"
            },
            "namespace": {
              "type": "string",
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
            },
            "family": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "edition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "issuing_body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "package_id": {
          "type": "string",
          "pattern": "^bcastpkg:sha256:[0-9a-f]{64}$"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "object_id",
              "kind",
              "locator",
              "status"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "pattern": "^bcastobj:sha256:[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "document",
                  "chapter",
                  "appendix",
                  "section",
                  "subsection",
                  "paragraph",
                  "list_item",
                  "definition_entry",
                  "table",
                  "figure",
                  "note",
                  "unsupported"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "status": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "unsupported"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "parent_id": {
                "type": "string",
                "pattern": "^bcastobj:sha256:[0-9a-f]{64}$"
              },
              "content": {
                "type": "object",
                "required": [
                  "media_type",
                  "text"
                ],
                "properties": {
                  "media_type": {
                    "const": "text/plain"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "provenance": {
                "type": "object",
                "required": [
                  "citation",
                  "source_artifact_sha256"
                ],
                "properties": {
                  "citation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "source_artifact_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passage_id",
        "kind",
        "locator",
        "source_object_id",
        "pdf_page",
        "bbox_millipoints",
        "text",
        "text_sha256"
      ],
      "properties": {
        "passage_id": {
          "type": "string",
          "pattern": "^bcastpassage:sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "section",
            "subsection",
            "paragraph"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_object_id": {
          "type": "string",
          "pattern": "^bcastobj:sha256:[0-9a-f]{64}$"
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox_millipoints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "passage_id",
        "modality",
        "disposition",
        "dependencies"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "passage_id": {
          "type": "string",
          "pattern": "^bcastpassage:sha256:[0-9a-f]{64}$"
        },
        "modality": {
          "enum": [
            "obligation",
            "prohibition",
            "permission"
          ]
        },
        "disposition": {
          "enum": [
            "admitted",
            "unresolved",
            "rejected"
          ]
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "exception": {
          "$ref": "#/$defs/expression"
        },
        "predicate": {
          "$ref": "#/$defs/expression"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator",
              "resolved"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "resolved": {
                "type": "boolean"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "review_ref"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "review_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "admitted"
              }
            }
          },
          "then": {
            "required": [
              "predicate",
              "review"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "unresolved",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "predicate"
                  ]
                },
                {
                  "required": [
                    "review"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "op",
            "value"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bool"
                  ],
                  "properties": {
                    "bool": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quantity"
                  ],
                  "properties": {
                    "quantity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "decimal",
                        "unit"
                      ],
                      "properties": {
                        "decimal": {
                          "type": "string",
                          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
